{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XR Coding Agent Event",
  "type": "object",
  "required": ["type", "ts", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "avatar.listening",
        "avatar.thinking",
        "avatar.speaking",
        "speech.transcript",
        "project.selected",
        "hermes.status",
        "assistant.reply",
        "session.started",
        "session.output",
        "session.finished",
        "session.failed",
        "terminal.started",
        "terminal.input",
        "terminal.output",
        "terminal.screen",
        "terminal.finished",
        "terminal.failed",
        "worker.updated",
        "worker.pending_question",
        "coding_sessions.synced",
        "agent.summary"
      ]
    },
    "ts": {
      "type": "string"
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object"
    }
  }
}
