# Optional Vite/Quest browser settings. Copy to apps/metaquest-client/.env.local only if needed.
# Do not put OpenAI, ElevenLabs, Kimi, or other API keys in this client env file.

# Same-origin websocket bridge target for the Mac companion.
XR_METAQUEST_BACKEND_TARGET=ws://127.0.0.1:8765

# Local HTTPS certs for Quest Browser WebXR/mic permissions.
# Generate your own files under apps/metaquest-client/.certs/.
XR_METAQUEST_HTTPS_CERT=.certs/quest-cert.pem
XR_METAQUEST_HTTPS_KEY=.certs/quest-key.pem

# Enable the same-origin bridge in production-style local builds.
VITE_XR_ENABLE_BRIDGE=true
