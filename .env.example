# Copy this file to the repo-root .env.local on your Mac.
# This file is for the Mac companion only. Never commit .env.local.

# Required for OpenAI Realtime voice. Without this, live voice-to-voice will not start.
# Keep the API key on the Mac companion only; do not put it in the Quest client env.
OPENAI_API_KEY=

# Realtime voice profile:
# - demo: lowest-latency, funny video/demo mode. Defaults to gpt-realtime-1.5.
# - operator: smarter real-use mode. Defaults to gpt-realtime-2 with low reasoning.
OPENAI_REALTIME_PROFILE=demo
# OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional low-latency Yuki speech output. Without this, backend ElevenLabs TTS is disabled.
# ELEVENLABS_VOICE_ID avoids a slower first-turn voice lookup.
XR_AGENT_VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_MODE=streaming
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# Kimi Code worker support. Recommended: run `kimi login` instead of storing an API key.
# A bad KIMI_API_KEY overrides a working OAuth login, so leave it commented unless needed.
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL_NAME=kimi-for-coding
KIMI_CLI_NO_AUTO_UPDATE=1
# KIMI_API_KEY=

# Mac companion websocket.
XR_AGENT_EVENT_HOST=0.0.0.0
XR_AGENT_EVENT_PORT=8765
